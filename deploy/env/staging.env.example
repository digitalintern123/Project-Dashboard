# /etc/encalm/staging.env  (owner root:encalm, mode 640)
# Staging must have its OWN secrets and data: never copy production's
# JWT_SECRET or SETTINGS_ENCRYPTION_KEY here.
NODE_ENV=production
APP_BASE_URL=https://staging.projects.example.com
DATA_DIR=/var/lib/encalm/staging
# openssl rand -base64 48 (different from production)
JWT_SECRET=
# openssl rand -base64 32 (different from production)
SETTINGS_ENCRYPTION_KEY=
COOKIE_DOMAIN=
CORS_ORIGIN=
# Staging may be reset to test imports; production never.
ALLOW_SYSTEM_RESET=true

SENTRY_DSN=

# Leave SMTP empty so staging cannot email real people; mail stays in the in-app outbox.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

RCLONE_REMOTE=
