# /etc/encalm/production.env  (owner root:encalm, mode 640)
# setup-vps.sh generates this with fresh secrets; see .env.example for every option.
NODE_ENV=production
APP_BASE_URL=https://projects.example.com
DATA_DIR=/var/lib/encalm/production
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
COOKIE_DOMAIN=
CORS_ORIGIN=
ALLOW_SYSTEM_RESET=false

SENTRY_DSN=

SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# e.g. b2:encalm-backups/production
RCLONE_REMOTE=
