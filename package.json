{
  "name": "encalm-project-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"cyan,magenta\" \"npm run server\" \"vite\"",
    "dev:web": "vite",
    "server": "tsx watch server/src/index.ts",
    "seed": "tsx -e \"import { seedDatabase } from './server/src/db/seed.js'; seedDatabase(true);\"",
    "build": "vite build && npm run typecheck",
    "build:client": "vite build",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create-user": "tsx server/src/scripts/create-user.ts",
    "restore:all": "tsx server/src/scripts/restore-all-pdfs.ts",
    "seed:all": "tsx server/src/scripts/restore-all-pdfs.ts",
    "test:live": "tsx server/src/scripts/test-all-apis.ts"
  },
