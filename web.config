<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode (Plesk on Windows). Every request goes to server.cjs; the
  Express app serves the web app from dist/ itself, with the right caching.
  Needs the Plesk Node.js "Document Root" set to the same folder as this file
  (/httpdocs), the same as "Application Root". See PRODUCTION.md, section 15.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="iisnode" />
      <add name="iisnode" path="server.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="encalm-app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.cjs" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Never serve server files, dependencies, settings or the iisnode logs
             (which hold the first-run temporary passwords). -->
        <!-- remove-then-add: Plesk/IIS may already define some of these, and a
             duplicate entry is a 500.19 configuration error. -->
        <hiddenSegments>
          <remove segment="node_modules" />
          <add segment="node_modules" />
          <remove segment="iisnode" />
          <add segment="iisnode" />
          <remove segment="server" />
          <add segment="server" />
          <remove segment=".env" />
          <add segment=".env" />
          <remove segment=".git" />
          <add segment=".git" />
        </hiddenSegments>
        <!-- Photo uploads: same 210 MB ceiling as deploy/nginx.conf; the app
             enforces the real per-request limits. -->
        <requestLimits maxAllowedContentLength="220200960" />
      </requestFiltering>
    </security>

    <!-- Let the app's own JSON errors and 404 page through. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
