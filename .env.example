# Copy this file to .env.local and edit as needed.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Only variables prefixed with VITE_ are exposed to
# the browser bundle, so never put a secret in one — anything VITE_-prefixed is
# readable by anyone who opens the site.

# Port for `npm run dev` and `npm run preview`. Read by vite.config.ts.
PORT=5173

# Base path if the app is served from a sub-folder (e.g. /dashboard/).
BASE_PATH=/

# Shown in the browser tab and the sign-in screen.
VITE_APP_NAME=Encalm Projects
VITE_ORG_NAME=Encalm Hospitality
