# ==============================================================================
# Encalm Project Dashboard: environment variables
#
# Local development: copy to .env (cp .env.example .env); everything is optional.
# VPS: deploy/setup-vps.sh writes /etc/encalm/<production|staging>.env with the
# secrets generated; deploy/env/*.env.example show what each one should hold.
# The app reads .env from its working directory, or the file named by
# DOTENV_CONFIG_PATH (the PM2 ecosystem sets this). Variables already set in
# the process environment always win over the file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# "production" turns on secure cookies and refuses to start without the secrets below.
NODE_ENV=development
# Port the API listens on (PORT and BACKEND_PORT are accepted as fallbacks).
API_PORT=5000
# Interface to bind. Behind Nginx use 127.0.0.1 so the port is not public;
# Docker needs 0.0.0.0 (the default).
HOST=
# Base path the SPA is served under at build time (leave as / unless hosted in a subfolder).
BASE_PATH=/

# ------------------------------------------------------------------------------
# Security (REQUIRED in production)
# ------------------------------------------------------------------------------
# Signs session tokens. At least 32 characters and not a known default.
# Generate: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# Encrypts the SMTP password and Graph client secret stored in the database
# (AES-256-GCM). 32 random bytes, base64 or hex. Generate: openssl rand -base64 32
# Keep it safe: if it is lost or changed, re-enter the email secrets in Settings.
SETTINGS_ENCRYPTION_KEY=

# Public URL of the dashboard; used for links in emails. Example: https://projects.example.com
APP_BASE_URL=

# Cookie domain for session cookies. Leave empty to bind cookies to the exact
# host serving the app (recommended).
COOKIE_DOMAIN=

# Extra origins allowed to call the API cross-origin, comma-separated.
# Leave empty: the app and API share one host.
CORS_ORIGIN=

# Requests per IP per 15 minutes.
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
EMAIL_RATE_LIMIT=100

# Allow POST /api/system/reset and /clear (wipe all project data) in production.
# Leave false except during a deliberate administrative reset.
ALLOW_SYSTEM_RESET=false

# ------------------------------------------------------------------------------
# Data
# ------------------------------------------------------------------------------
# Directory holding encalm.db and uploads/. Default ./server/data.
# On the VPS: /var/lib/encalm/<env>, outside the code so deploys never touch it.
DATA_DIR=
# Database file, if it should live somewhere other than $DATA_DIR/encalm.db.
DATABASE_PATH=

# ------------------------------------------------------------------------------
# Backups (scripts/backup.sh, scripts/restore.sh, nightly cron on the VPS)
# ------------------------------------------------------------------------------
# Where backups are written. Default /var/backups/encalm (/var/backups/encalm/<env> on the VPS).
BACKUP_DIR=
# Local backups older than this many days are deleted.
RETENTION_DAYS=30
# Optional off-site copy with rclone, e.g. b2:encalm-backups/production
# (configure the remote once with `rclone config` as the app user).
RCLONE_REMOTE=
# Remote backups older than this many days are deleted (default: RETENTION_DAYS).
RCLONE_RETENTION_DAYS=

# Backups made by the app itself (any OS, e.g. Plesk on Windows): a consistent
# online copy of the database, gzipped, plus a mirror of the photos, in
# BACKUP_DIR (default: <DATA_DIR>/backups). On by default in production; the
# Linux VPS turns it off because cron runs scripts/backup.sh instead.
BACKUP_ENABLED=
# Daily run time, server local time (HH:MM).
BACKUP_TIME=02:15
# App backups older than this many days are deleted (the newest 7 are always kept).
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent. Default info (silent in tests).
LOG_LEVEL=
# "json" forces JSON lines in a terminal; production always logs JSON.
LOG_FORMAT=

# ------------------------------------------------------------------------------
# Error tracking: Sentry (optional; off unless SENTRY_DSN is set)
# ------------------------------------------------------------------------------
# Server DSN from sentry.io (Project settings > Client Keys).
SENTRY_DSN=
# Browser DSN, if browser errors go to a separate Sentry project. Defaults to SENTRY_DSN.
SENTRY_CLIENT_DSN=
# Environment name shown in Sentry. The PM2 ecosystem sets production/staging.
SENTRY_ENVIRONMENT=
# Share of requests traced for performance (0 to 1). Default 0: errors only.
SENTRY_TRACES_SAMPLE_RATE=0
# Release id reported with each error. Set automatically by deploy/deploy.sh.
APP_RELEASE=

# ------------------------------------------------------------------------------
# Email: SMTP (fallback when Microsoft 365 is not configured)
# These are defaults; values saved in the app's Email settings take precedence.
# Mail is sent from SMTP_USER, shown as "<user> via Encalm Projects", with replies
# to the person who sent it. There is no separate From address.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
# true for implicit TLS (port 465); false uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Encalm Project Dashboard
# Only for a test server with a self-signed certificate. Never true in production.
SMTP_ALLOW_SELF_SIGNED=false

# ------------------------------------------------------------------------------
# Email: Microsoft 365 via Microsoft Graph (preferred). Set here only: the app
# never shows or accepts these. Azure app with Application permissions Mail.Send
# and User.Read.All, admin consent granted. See PRODUCTION.md, "Email".
# Each email goes from the signed-in user's own mailbox when their address is in
# MS_GRAPH_SEND_AS_DOMAINS (default: the domain of MS_GRAPH_SENDER_EMAIL);
# everyone else goes through MS_GRAPH_SENDER_EMAIL with replies to them.
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET are accepted as aliases.
# ------------------------------------------------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=
MS_GRAPH_SEND_AS_DOMAINS=

# ------------------------------------------------------------------------------
# Frontend build (Vite; baked into the bundle at build time, never secrets)
# ------------------------------------------------------------------------------
# API origin when the SPA is served from a different host. Empty = same origin.
VITE_API_URL=
