# Don't run dependency install scripts. The only ones in this project are
# better-sqlite3's source build (not needed: it ships prebuilt binaries for
# Windows, Linux and macOS, and its build needs Python + C++ tools that Windows
# servers lack), esbuild's binary check, and Husky's hook setup. Explicit
# `npm run <script>` commands still run normally.
# After cloning, run `npx husky` once to enable the pre-commit hook.
ignore-scripts=true
